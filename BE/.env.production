# ==============================================================================
# PRODUCTION — Tất cả services & infra chạy trong Docker (internal hostnames)
# ------------------------------------------------------------------------------
# Dùng với docker-compose:  docker-compose --env-file .env.production up -d
# QUAN TRỌNG: Thay toàn bộ <CHANGE_ME> trước khi deploy!
# ==============================================================================

# ── Common ────────────────────────────────────────────────────────────────────
JWT_SIGNER_KEY=<CHANGE_ME_MIN_256BIT_RANDOM_SECRET>
ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Infrastructure — internal Docker network ports ────────────────────────────
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=<CHANGE_ME>
MONGO_HOST_PORT=27017

MYSQL_ROOT_PASS=<CHANGE_ME>
MYSQL_HOST_PORT=3306

REDIS_HOST=redis
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_PORT=9094

ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URIS=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=<CHANGE_ME>
ES_JAVA_OPTS=-Xms1g -Xmx1g

ZIPKIN_PORT=9411
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASS=<CHANGE_ME>

# ── Discovery Service  (HTTP :6059) ───────────────────────────────────────────
DISCOVERY_SERVICE_PORT=6059
EUREKA_HOSTNAME=discovery-service
EUREKA_URI=http://discovery-service:6059/eureka/

# ── API Gateway  (HTTP :6060) ─────────────────────────────────────────────────
API_GATEWAY_PORT=6060

# ── Identity Service  (HTTP :6062 | MySQL internal :3306) ────────────────────
IDENTITY_SERVICE_PORT=6062
IDENTITY_DB_HOST=mysql
IDENTITY_DB_PORT=3306
IDENTITY_DB_NAME=identityservice
IDENTITY_DB_USER=appuser
IDENTITY_DB_PASS=<CHANGE_ME>

# ── User Service  (HTTP :6063 | gRPC :6163 | MongoDB) ────────────────────────
USER_SERVICE_PORT=6063
USER_SERVICE_GRPC_PORT=6163
USER_MONGO_URI=mongodb://root:<CHANGE_ME>@mongodb:27017/user-service?authSource=admin

# ── Product Service  (HTTP :6067 | gRPC :6167 | MongoDB + ES) ────────────────
PRODUCT_SERVICE_PORT=6067
PRODUCT_SERVICE_GRPC_PORT=6167
PRODUCT_MONGO_URI=mongodb://root:<CHANGE_ME>@mongodb:27017/product-service?authSource=admin

# ── Order Service  (HTTP :6065 | gRPC :6165 | MongoDB) ───────────────────────
ORDER_SERVICE_PORT=6065
ORDER_SERVICE_GRPC_PORT=6165
ORDER_MONGO_URI=mongodb://root:<CHANGE_ME>@mongodb:27017/order-service?authSource=admin

# ── Chat Service  (HTTP :8085 | MongoDB) ──────────────────────────────────────
CHAT_SERVICE_PORT=8085
CHAT_MONGO_URI=mongodb://root:<CHANGE_ME>@mongodb:27017/chat-service?authSource=admin

# ── File Service  (HTTP :8084 | MongoDB | S3 | Cloudinary | Gemini) ───────────
FILE_SERVICE_PORT=8084
FILE_MONGO_URI=mongodb://root:<CHANGE_ME>@mongodb:27017/file-service?authSource=admin
AWS_ACCESS_KEY_ID=<CHANGE_ME>
AWS_SECRET_ACCESS_KEY=<CHANGE_ME>
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=<CHANGE_ME>
CLOUDINARY_CLOUD_NAME=<CHANGE_ME>
CLOUDINARY_API_KEY=<CHANGE_ME>
CLOUDINARY_API_SECRET=<CHANGE_ME>
GEMINI_API_KEY=<CHANGE_ME>
GEMINI_API_MODEL=gemini-1.5-flash
FILE_STORAGE_DIR=/app/uploads
FILE_DOWNLOAD_PREFIX=https://yourdomain.com/file/media/download/

# ── Notification Service  (HTTP :6068 | MongoDB) ─────────────────────────────
NOTIFICATION_SERVICE_PORT=6068
NOTIFICATION_MONGO_URI=mongodb://root:<CHANGE_ME>@mongodb:27017/notification-service?authSource=admin
BREVO_API_KEY=<CHANGE_ME>

# ── Saga Orchestrator  (HTTP :6058 | gRPC :6158) ─────────────────────────────
SAGA_ORCHESTRATOR_PORT=6058
SAGA_ORCHESTRATOR_GRPC_PORT=6158
USER_SERVICE_GRPC_ADDRESS=discovery:///USER-SERVICE
USER_SERVICE_GRPC_DEADLINE_MS=3000
