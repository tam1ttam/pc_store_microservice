# ==============================================================================
# DEVELOPMENT — Services chạy local, Infrastructure chạy trong Docker
# ------------------------------------------------------------------------------
# Dùng với docker-compose:  docker-compose --env-file .env.development up -d
# Dùng với Spring Boot:     export $(grep -v '^#' .env.development | xargs)
# ==============================================================================

# ── JVM Memory — áp dụng cho mọi service Spring Boot chạy local ──────────────
# JAVA_TOOL_OPTIONS được JVM tự đọc khi start, không cần config thêm
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m -XX:+UseSerialGC -XX:TieredStopAtLevel=1

# ── Common ────────────────────────────────────────────────────────────────────
JWT_SIGNER_KEY=1TjXchw5FloESb63Kc+DFhTARvpWL4jUGCwfGWxuG5SIf/1y/LgJxHnMqaF6A/ij
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3003,http://localhost:3004

# ── Infrastructure — Docker host-mapped ports ─────────────────────────────────
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=123456
MONGO_HOST_PORT=6000

MYSQL_ROOT_PASS=123456
MYSQL_HOST_PORT=6001

REDIS_HOST=localhost
REDIS_PORT=6002

KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_EXTERNAL_PORT=9094

ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=password
ES_JAVA_OPTS=-Xms512m -Xmx512m

ZIPKIN_PORT=9411
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASS=admin

# ── Discovery Service  (HTTP :6059) ───────────────────────────────────────────
DISCOVERY_SERVICE_PORT=6059
EUREKA_HOSTNAME=localhost
EUREKA_URI=http://localhost:6059/eureka/

# ── API Gateway  (HTTP :6060) ─────────────────────────────────────────────────
API_GATEWAY_PORT=6060

# ── Identity Service  (HTTP :6062 | MySQL :6001) ──────────────────────────────
IDENTITY_SERVICE_PORT=6062
IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=6001
IDENTITY_DB_NAME=identityservice
IDENTITY_DB_USER=appuser
IDENTITY_DB_PASS=123456

# ── User Service  (HTTP :6063 | gRPC :6163 | MongoDB) ────────────────────────
USER_SERVICE_PORT=6063
USER_SERVICE_GRPC_PORT=6163
USER_MONGO_URI=mongodb://root:123456@localhost:6000/user-service?authSource=admin

# ── Product Service  (HTTP :6067 | gRPC :6167 | MongoDB + ES) ────────────────
PRODUCT_SERVICE_PORT=6067
PRODUCT_SERVICE_GRPC_PORT=6167
PRODUCT_MONGO_URI=mongodb://root:123456@localhost:6000/product-service?authSource=admin

# ── Order Service  (HTTP :6065 | gRPC :6165 | MongoDB) ───────────────────────
ORDER_SERVICE_PORT=6065
ORDER_SERVICE_GRPC_PORT=6165
ORDER_MONGO_URI=mongodb://root:123456@localhost:6000/order-service?authSource=admin

# ── Chat Service  (HTTP :8085 | MongoDB) ──────────────────────────────────────
CHAT_SERVICE_PORT=8085
CHAT_MONGO_URI=mongodb://root:123456@localhost:6000/chat-service?authSource=admin

# ── File Service  (HTTP :8084 | MongoDB | S3 | Cloudinary | Gemini) ───────────
FILE_SERVICE_PORT=8084
FILE_MONGO_URI=mongodb://root:123456@localhost:6000/file-service?authSource=admin
AWS_ACCESS_KEY_ID=<dev-aws-access-key>
AWS_SECRET_ACCESS_KEY=<dev-aws-secret-key>
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=<dev-bucket-name>
CLOUDINARY_CLOUD_NAME=social-example-project-vutran
CLOUDINARY_API_KEY=938536251322765
CLOUDINARY_API_SECRET=_Oq_jfcVYzq7TCS3hPm4WopUVrQ
GEMINI_API_KEY=<dev-gemini-api-key>
GEMINI_API_MODEL=gemini-1.5-flash
FILE_STORAGE_DIR=./uploads
FILE_DOWNLOAD_PREFIX=http://localhost:8084/file/media/download/

# ── Notification Service  (HTTP :6068 | MongoDB) ─────────────────────────────
NOTIFICATION_SERVICE_PORT=6068
NOTIFICATION_MONGO_URI=mongodb://root:123456@localhost:6000/notification-service?authSource=admin
BREVO_API_KEY=<dev-brevo-api-key>

# ── Saga Orchestrator  (HTTP :6058 | gRPC :6158) ─────────────────────────────
SAGA_ORCHESTRATOR_PORT=6058
SAGA_ORCHESTRATOR_GRPC_PORT=6158
USER_SERVICE_GRPC_ADDRESS=discovery:///USER-SERVICE
USER_SERVICE_GRPC_DEADLINE_MS=3000
