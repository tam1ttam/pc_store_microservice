# ******************
# Database (Postgres)
# ******************
POSTGRES_VERSION=16.3
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=iluttmab_db
DB_HOST=localhost
DB_PORT=5432

# ******************
# Keycloak (iluttmab Realm)
# ******************
KEYCLOAK_VERSION=25.0.2
KEYCLOAK_PORT=8181
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Thông tin Client để Identity Service gọi Admin API
KEYCLOAK_REALM=iluttmab
KEYCLOAK_SERVER_URL=http://localhost:8181
KEYCLOAK_ADMIN_CLIENT_ID=iluttmab-admin-client
KEYCLOAK_ADMIN_CLIENT_SECRET=qEtqS9STfjKuzU99109MTtlZfCcL8UBi

# Client cho User đăng nhập
KEYCLOAK_CLIENT_ID=iluttmab-client
KEYCLOAK_CLIENT_SECRET=BnaPyiYRiG0LP8sGdQNuCp1eZ32IFIya

# Issuer URI cho tất cả Resource Servers (Chí mạng!)
KEYCLOAK_ISSUER_URI=http://localhost:8181/realms/iluttmab

# ******************
# Cloudinary (Media thay cho MinIO)
# ******************
CLOUDINARY_CLOUD_NAME=your_name_here
CLOUDINARY_API_KEY=your_key_here
CLOUDINARY_API_SECRET=your_secret_here

# ******************
# Kafka & Zookeeper
# ******************
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ******************
# Elasticsearch
# ******************
ELASTIC_VERSION=8.15.0
ELASTIC_PASSWORD=tienha@!@#

# ******************
# Swagger UI (Chỉ giữ lại các cụm đã gộp)
# ******************
SWAGGER_URLS=[{ url: 'http://localhost:6060/api-gateway/product-service/v3/api-docs', name: 'Product' },{ url: 'http://localhost:6060/api-gateway/user-service/v3/api-docs', name: 'User' },{ url: 'http://localhost:6060/api-gateway/order-service/v3/api-docs', name: 'Order' },{ url: 'http://localhost:6060/api-gateway/identity-service/v3/api-docs', name: 'Identity' }]

# ******************
# Redis (Cho Identity ban IP/Spam)
# ******************
REDIS_PORT=6379
REDIS_PASSWORD=tienha@!@#