# AI Agent Service environment variables

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CHAT_MESSAGES_TOPIC=chat-messages
KAFKA_AI_REPLIES_TOPIC=ai-replies
KAFKA_CONSUMER_GROUP=ai-agent-group

# Service URLs
CHAT_SERVICE_URL=http://localhost:6060/api-gateway/chat-service
PRODUCT_SERVICE_URL=http://localhost:6060/api-gateway/product-service
ORDER_SERVICE_URL=http://localhost:6060/api-gateway/order-service

# Eureka
# Optional: service-account token for calling protected order-service endpoints
AI_SERVICE_TOKEN=
EUREKA_SERVER=http://localhost:6059/eureka
EUREKA_INSTANCE_HOST=localhost
EUREKA_INSTANCE_PORT=6070
